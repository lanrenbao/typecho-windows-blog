// pm2 process definitions.
// Install: npm install -g pm2
// Start:   pm2 start ecosystem.config.js && pm2 save
module.exports = {
  apps: [
    {
      name: 'typecho-cgi-1',
      script: 'D:/server/php/php-cgi.exe',
      args: '-b 127.0.0.1:9001 -c D:/server/php/php.ini',
      interpreter: 'none',
      cwd: 'D:/server/www',
      exec_mode: 'fork',
      autorestart: true,
      restart_delay: 3000,
      max_restarts: 30,
      env: { PHP_FCGI_MAX_REQUESTS: '2000' }
    },
    {
      name: 'typecho-cgi-2',
      script: 'D:/server/php/php-cgi.exe',
      args: '-b 127.0.0.1:9002 -c D:/server/php/php.ini',
      interpreter: 'none',
      cwd: 'D:/server/www',
      exec_mode: 'fork',
      autorestart: true,
      restart_delay: 3000,
      max_restarts: 30,
      env: { PHP_FCGI_MAX_REQUESTS: '2000' }
    },
    {
      name: 'typecho-cgi-3',
      script: 'D:/server/php/php-cgi.exe',
      args: '-b 127.0.0.1:9003 -c D:/server/php/php.ini',
      interpreter: 'none',
      cwd: 'D:/server/www',
      exec_mode: 'fork',
      autorestart: true,
      restart_delay: 3000,
      max_restarts: 30,
      env: { PHP_FCGI_MAX_REQUESTS: '2000' }
    },
    {
      name: 'typecho-web',
      script: 'D:/server/caddy/caddy.exe',
      args: 'run --config D:/server/Caddyfile --adapter caddyfile',
      interpreter: 'none',
      cwd: 'D:/server',
      exec_mode: 'fork',
      autorestart: true,
      restart_delay: 2000,
      max_restarts: 30
    },
    {
      // Cloudflare named tunnel -> https://your.domain
      // After `cloudflared tunnel create`, fill in cloudflared/config.yml
      name: 'cf-tunnel',
      script: 'D:/server/cloudflared/cloudflared.exe',
      // NOTE: --no-autoupdate must come BEFORE the `run` subcommand
      args: '--config D:/server/cloudflared/config.yml tunnel --no-autoupdate --protocol http2 run',
      interpreter: 'none',
      cwd: 'D:/server/cloudflared',
      exec_mode: 'fork',
      autorestart: true,
      restart_delay: 5000,
      max_restarts: 100,
      out_file: 'D:/server/logs/cf-tunnel-out.log',
      error_file: 'D:/server/logs/cf-tunnel.log',
      merge_logs: true,
      time: true
    }
  ]
};
