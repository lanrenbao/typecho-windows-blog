# Cloudflare Tunnel config for a named tunnel.
#
# 1. cloudflared tunnel login          (browser authorization, once)
# 2. cloudflared tunnel create typecho -> prints <TUNNEL-UUID>
# 3. cloudflared tunnel route dns typecho blog.example.com
# 4. fill in <TUNNEL-UUID> below, then start via pm2 (see ecosystem.config.js)

tunnel: <TUNNEL-UUID>
credentials-file: C:\Users\<YOUR-WINDOWS-USER>\.cloudflared\<TUNNEL-UUID>.json

ingress:
  - hostname: blog.example.com
    service: http://127.0.0.1:8080
  - service: http_status:404
